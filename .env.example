# Shared Database A Supabase credentials (Google OAuth + profiles.is_superadmin == TRUE)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Dual-Key Gemini Configuration
# Project A ($0 Free Tier — Steps 1..3 text models: gemini-3.5-flash-lite, gemini-3-flash-preview, gemini-3.1-flash-lite)
GEMINI_API_KEY=your-google-ai-studio-free-tier-key

# Project B (Paid Credit — Step 4 cheap $0.0336/img Flash image models: gemini-3.1-flash-lite-image, gemini-nano-banana-2.1)
GEMINI_PAID_API_KEY=your-google-ai-studio-paid-tier-key

# Optional site origin for Google OAuth callbacks (e.g. https://your-app.vercel.app without trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Optional daily image generation cap across app_scope = 'hanzi_mnemonic' (default: 40)
DAILY_IMAGE_CAP=40
